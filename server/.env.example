# App configuration
PORT=3000
NODE_ENV=development

# Database configuration (PostgreSQL + pgvector)
# URL pattern: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/tmdt_ai?schema=public"

# Docker specific (match docker-compose.yml defaults if needed)
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=tmdt_ai
DB_PORT=5432

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT configuration
JWT_SECRET=super-secret-key-change-me-in-production
JWT_EXPIRE=1d
JWT_REFRESH_SECRET=refresh-token-secret
JWT_REFRESH_EXPIRE=7d

# AI Configuration (OpenAI)
OPENAI_API_KEY=your-openai-api-key

# Frontend URL used in emails
FRONTEND_URL=http://localhost:3000

# Mail configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Ultra Shop

# SePay bank transfer
SEPAY_BANK_ID=MB
SEPAY_ACCOUNT_NO=your-bank-account-number
SEPAY_ACCOUNT_NAME="YOUR BANK ACCOUNT NAME"
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
SEPAY_API_TOKEN=your-sepay-api-token
SEPAY_API_TIMEOUT_MS=10000
SEPAY_POLLING_ENABLED=true
SEPAY_POLLING_INTERVAL_MS=10000
SEPAY_PROCESS_EXISTING_ON_STARTUP=false
SEPAY_WEBHOOK_API_KEY=your-sepay-webhook-api-key

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100
