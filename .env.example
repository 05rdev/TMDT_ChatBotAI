# APP
NODE_ENV=development
PORT=3000

# DATABASE - PostgreSQL
POSTGRES_USER=tmdt_user
POSTGRES_PASSWORD=tmdt_password
POSTGRES_DB=tmdt_db
# Dùng 'localhost' nếu chạy app bằng npm run dev trên máy thật
# Dùng 'postgres' nếu chạy app trong docker container (service name)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# REDIS
# Dùng 'localhost' nếu chạy app bằng npm run dev trên máy thật
# Dùng 'redis' nếu chạy app trong docker container (service name)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars_here
JWT_REFRESH_EXPIRES_IN=30d

# OPENAI / AI
OPENAI_API_KEY=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
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# FILE UPLOAD
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# CORS
CORS_ORIGIN=http://localhost:5173

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# LOGGING
LOG_LEVEL=debug
